# ---------------------------------------------------------------------------
# Environment template — copy to `.env.local` (or `.env`) and fill in real values.
# NEVER commit real secrets; only this placeholder template is tracked in git.
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Nodemailer / SMTP)
# Optional: these are only the FALLBACK. The preferred place to configure email
# is Admin → Email, which stores the settings in the database (password
# encrypted) and offers a connection test plus a test send. Anything saved there
# takes precedence over the variables below.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@example.com"
EMAIL_REPLY_TO=""

# Site
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# PayPal (Bookstore)
#
# Prerequisites, in order:
#   1. A PayPal BUSINESS account. A personal account cannot accept commercial
#      payments through the Orders v2 API — upgrade at paypal.com → Settings.
#   2. At https://developer.paypal.com → Apps & Credentials, create a REST app.
#      That screen gives you the Client ID and Secret below. The Merchant ID
#      shown in your PayPal profile is NOT an API credential and is not used here.
#   3. Add a webhook on that app pointing at
#      https://<your-domain>/api/store/paypal/webhook and copy its Webhook ID.
#
# Keep PAYPAL_ENV="sandbox" until a test purchase completes end to end, then
# switch to "live" and swap in the live app's credentials.
#
# If these are unset the storefront simply hides PayPal and offers mobile money,
# so the shop keeps working while you set this up.
# ---------------------------------------------------------------------------
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="your-paypal-rest-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-rest-secret"
# Webhook id from the PayPal app's webhook (points to /api/store/paypal/webhook)
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
# Client-side SDK id (safe to expose). Usually the same value as PAYPAL_CLIENT_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-rest-client-id"

# ---------------------------------------------------------------------------
# PayPal to PayPal (direct transfer) — the SIMPLE option, no API setup.
#
# Set either of these and the storefront offers "PayPal" without any REST
# credentials: the buyer sends the total straight to your PayPal account and you
# confirm it in Admin → Orders, exactly like mobile money. Works with an
# ordinary personal PayPal account.
#
# If the REST credentials above are also set, the automatic flow wins (it
# unlocks downloads instantly) and these are ignored.
#
# Both already default in code to the merchant's own account
# (paypal.me/amanidd399 / amanidieudonnekonan@gmail.com), so the direct flow
# works with no configuration at all. Set these only to redirect payments
# elsewhere. NEXT_PUBLIC_PAYPAL_ME takes the handle alone or the full URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_ME=""
NEXT_PUBLIC_PAYPAL_EMAIL=""

# ---------------------------------------------------------------------------
# AI enrichment (Bookstore) — drafts book descriptions & key insights.
# Optional: if unset, uploads still parse metadata; you just write copy yourself.
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Mobile money (Bookstore) — the number buyers send Wave/Djamo/Orange Money to.
# Payments are confirmed manually by an admin (no automated verification API).
# This is the only payment route for XOF-priced titles, which PayPal cannot settle.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MOBILE_MONEY_NUMBER="+225 07 47 88 22 35"
